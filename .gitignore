# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# SCORM training packages contain pre-built dist/ bundles — track them
!portal/client/public/training/**/dist/
!portal/client/public/training/**/dist/**

# Vite cache
.vite/

# Environment variables — never commit these
.env
.env.local
.env.*.local

# Editor
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite database files — never commit live database data
portal/data/*.db
portal/data/*.db-shm
portal/data/*.db-wal
portal/data/*.bak
# Large video files — host on CDN, not in git
*.mp4
*.mov
*.webm
*.avi
*.m4v

# Packshot source images — ~52 MB of PNGs staged locally for
# scripts/import-packshots.ts, which uploads them to S3. The canonical copy is
# S3, not git. The JSON catalog and the generator scripts alongside them ARE
# tracked: those are the reviewed metadata and must stay in version control.
portal/server/scripts/packshot-data/images/

# Local canvas/editor state for the nodeterm tool — per-machine window layout,
# not project source.
.nodeterm/
