# JWT secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://sliquid-b2b.pages.dev,https://your-portal.pages.dev

# Port (Railway sets this automatically)
PORT=3001

# Absolute path to the SQLite database file.
# On Railway: add a Volume mounted at /data in the dashboard, then set this to /data/portal.db
# Locally: leave unset — defaults to portal/data/portal.db
DB_PATH=/data/portal.db

# EmailJS — portal server email sending (all optional — emails skipped if unset)
# Get these from https://emailjs.com → Account → API Keys
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=your_emailjs_service_id

# URL of the deployed portal client (used in email links)
PORTAL_URL=https://sliquid-portal.pages.dev

# ─── Announcements / WordPress press-release sync ────────────────────────────
# All optional — the sync falls back to working defaults (sliquid.com, the
# "Press Releases" category id 245, cutoff 2025-01-01), so it works unconfigured.
# These can also be set at runtime from the portal admin UI, which stores them
# in the woo_settings key/value table. Env vars take precedence.

# WordPress base URL — no trailing slash, no /wp-json suffix
WP_BASE_URL=https://sliquid.com
# Category id to pull. 245 = "Press Releases"
WP_ANNOUNCEMENTS_CATEGORY_ID=245
# Posts published before this date are never imported (YYYY-MM-DD)
WP_ANNOUNCEMENTS_CUTOFF=2025-01-01

# Only needed to sync posts that are NOT yet published in WordPress
# (draft/pending/future). Leave unset for published-only, which needs no auth.
# Create via WordPress → Users → Profile → Application Passwords.
# WP_APP_USER=your_wp_username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── MCP endpoint — OAuth 2.1 resource server ────────────────────────────────
# Auth for the MCP endpoint that ChatGPT calls. It is a SEPARATE principal space
# from portal logins: these tokens are verified against the Sliquid SSO IdP as a
# *resource server* and never map to a row in the users table.

# The canonical URI of this MCP resource. Set the SAME string as the `audience`
# field on the ChatGPT client at https://sso.sliquid.com/admin/apps — the IdP
# pins `aud` per client rather than reading an RFC 8707 `resource` parameter
# (ChatGPT's connector may not send one). Compared BYTE FOR BYTE, so a
# trailing-slash mismatch rejects every token. Must be a valid URL: the IdP
# validates the field with `z.string().url()`, so a bare token like
# `sliquid-mcp` is refused at registration.
#
# ⚠️ If the client's `audience` is left blank, the IdP falls back to stamping the
# CLIENT ID into `aud` — every token then fails here, correctly but confusingly.
#
# ⚠️ THIS IS THE CONFUSED-DEPUTY DEFENSE. The portal's own SSO sessions and the
# MCP endpoint trust the SAME issuer and signing key, so without this audience
# binding an ordinary portal access token could be replayed against MCP.
MCP_RESOURCE_URI=https://sliquid-b2b-production.up.railway.app/mcp

# 'oauth' (default) = full token verification. 'none' = PILOT ESCAPE HATCH that
# skips verification and serves every caller as an anonymous wildcard principal;
# it logs a loud startup warning. Never set 'none' in production. Any other or
# missing value fails closed to 'oauth'.
MCP_AUTH_MODE=oauth

# Scope names advertised in /.well-known/oauth-protected-resource
# (space- or comma-separated). `assets:read` is what the MCP router enforces.
# `openid` is included because the Sliquid IdP rejects any authorize request whose
# effective scope set lacks it — a client that requested only `assets:read` could
# never complete the flow. All three tools are read-only; there is no write scope.
#
# ⚠️ Grant `assets:read` explicitly on the ChatGPT client. The IdP DROPS a scope it
# does not recognise, or that the client row was not granted, WITHOUT any error —
# authorize still succeeds and a token is minted without it. Every MCP call then
# 403s with insufficient_scope and nothing is logged on the IdP side. After
# consenting, check the `scope` value in the token response before debugging here.
MCP_SCOPES_SUPPORTED=openid assets:read

# Token verification reuses the existing SSO config — no separate JWKS needed:
#   SSO_ISSUER    — expected `iss`, and the authorization_servers entry in the
#                   RFC 9728 metadata document. This is the IdP *API* origin
#                   (https://sso-api.sliquid.com), NOT the portal UI origin
#                   (https://sso.sliquid.com) where admins register clients.
#                   Confirm against /.well-known/openid-configuration.
#   SSO_JWKS_URL   — https://sso-api.sliquid.com/oauth2/jwks. Publishes rotated
#                    keys as well as active ones, so verify by `kid`; never pin
#                    a single key.
# Both must be set whenever MCP_AUTH_MODE=oauth, or the endpoint returns 503.

# ─── MCP byte retrieval — TEMPORARY public-HTTPS fallback ────────────────────
# The server's IAM principal can PutObject but not GetObject, so the signed S3
# read 403s for every packshot. This is NOT a bucket-policy problem: the policy
# already grants GetObject to Principal:"*" AND explicitly to that user on
# product-shots/*, and both are denied while anonymous HTTPS reads return 200 —
# so the cap is a permissions boundary / explicit Deny / SCP on the IAM user.
#
# Until that is lifted, src/mcp/bytes.ts retries over plain HTTPS, but ONLY on a
# permission error (a 404 NoSuchKey still throws). The SHA-256 gate runs on
# whatever arrives, so tamper protection is identical on either transport.
#
# Set to 'off' to disable the fallback and restore hard failure. Any other value
# (or unset) leaves it enabled.
#
# ⚠️ REMOVE the fallback from bytes.ts once s3:GetObject is granted — see the
# TODO(iam) block there and docs/brand-agent/DEPLOYMENT.md.
# MCP_S3_PUBLIC_FALLBACK=off
